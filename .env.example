# AutoPilot IDE 环境变量样例
# 复制为仓库根 `.env` 后按需修改。
# `run.py` / `python -m autopilot.intent …` 启动时自动加载（已存在的环境变量不被覆盖）。
#
# 配置边界（勿与 Platform 服务端混写）：
#   platform.url / AUTOPILOT_PLATFORM_URL  → IDE 连哪台 Platform（企业 IT 配）
#   本文件 .env                            → IDE 客户端行为（Intent/Vision 等）
#   Platform 持证书、MC_SSL_*              → 只在 Autopilot-Platform 仓配置
#
# ┌─ Platform 通信地址（IDE 客户端）──────────────────────────────────────┐
# │ 企业分发：IT 用 platform.url（见 platform.url.example），不必在本文件写 URL │
# │ 开发联调：可设 AUTOPILOT_PLATFORM_URL；详见 Platform 仓 docs/setup/https.md │
# │ 均未配置 → 默认 http://127.0.0.1:8000                                         │
# └─────────────────────────────────────────────────────────────────────────┘
#
# AUTOPILOT_PLATFORM_URL=https://autopilot.company.com
#
# ┌─ HTTPS 客户端信任（仅 IDE 侧；服务端证书在 Platform 仓 MC_SSL_*）────────┐
# │ 公网 CA（Let's Encrypt 等）：**无需**下列变量，httpx 默认可校验。            │
# │ 企业内网私有 CA：IT 将 CA 证书下发到用户机固定路径，组策略设：               │
# │   AUTOPILOT_SSL_CA_FILE=C:\ProgramData\AutoPilot\corp-ca.crt                 │
# │ （路径由企业 IT 决定；**不要**引用 Platform 开发仓 data/tls 或 gen_tls_cert）│
# │ 双仓开发者本机自签联调：见 Platform 仓 start_dev_https / https.md §2.3       │
# └─────────────────────────────────────────────────────────────────────────┘
#
# ┌─ 其它 IDE 配置（详见 docs/CONFIGURATION.md）──────────────────────────┐
# │ Intent/Vision/Webhook：本文件 AUTOPILOT_*                               │
# │ 登录账号、项目、Token：IDE 登录 /「Platform 连接」→ settings.json       │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Platform 服务端 AI/Webhook 策略在 Platform 运维中心配置，不在本文件重复。
# 端口：8000=Platform API | 5173=Vite 开发 Web | 8765=IDE serve-webhook
#
# Windows 手工加载到当前进程（可选）:
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^\s*#' -or $_ -notmatch '=') { return }
#     $k,$v = $_.Split('=',2); [Environment]::SetEnvironmentVariable($k.Trim(), $v.Trim(), 'Process')
#   }

# ---------- 管理台连接 ----------
# 企业：见 platform.url；HTTPS 私有 CA 由 IT 组策略下发 AUTOPILOT_SSL_CA_FILE（见文件头）
# 开发联调可设 AUTOPILOT_ALLOW_PLATFORM_URL_OVERRIDE=1 后改 GUI 地址
# 独立 Runner：MC_SERVER=... MC_API_TOKEN=...
# AUTOPILOT_CONFIG_DIR=
# AUTOPILOT_LOG_DIR=
# 置 1 则启动时不自动加载 .env（测试/CI 用，避免本机 Key 与开关漏进进程）
# AUTOPILOT_NO_DOTENV=1

# ---------- Intent 自愈（不调 LLM；默认即可）----------
# AUTOPILOT_INTENT_HEAL_BUDGET_MS=3000
# AUTOPILOT_INTENT_HEAL_CANDIDATE_TIMEOUT_MS=1500
# 真机批跑 iOS 建议开，避免每条用例重拉 WDA：
# AUTOPILOT_INTENT_KEEP_WDA=1
# IOS_KEEP_WDA=1
# Runner 连续 Job 复用本进程 Appium（跳过 suite teardown；默认关）：
# AUTOPILOT_RUNNER_KEEP_APPIUM=1

# ---------- Intent Vision（默认关；只配「一套」厂商，不要多段都解开）----------
# 规则：
#   1) AUTOPILOT_INTENT_VISION=0 -> 永不调 LLM 定位兜底（推荐日常 / 企业用户 IDE）
#   2) =1 时必须有可用 Key
#   3) 密钥边界（AUD-P2-007）：企业锁定 AUTOPILOT_PLATFORM_URL / platform.url 时，
#      默认忽略本机 Vision Key（与链路 3「企业 Key 只在 Platform」一致）。
#      Runner 由 IT 注入 Key 时须另设 AUTOPILOT_VISION_ALLOW_LOCAL_KEY=1。
#      用户机器勿放企业厂商 Key；Design/编写走 Platform Ops，Vision 默认保持关闭。
#   4) IMAGE_MODE=auto（默认）：按型号能力传图。DeepSeek 文本型号（v4-flash / v4-pro）走 DOM；
#      deepseek-v4-flash-vision-exp 走截图识图（先按控件预裁剪）。
#   5) 其它真截图多模态：OpenAI gpt-5-mini / Gemini 3.5 / 千问 VL；IMAGE_MODE=force 仍不能伪造文本型号能力
#   6) Key 查找：AUTOPILOT_VISION_API_KEY -> AP_AI_API_KEY -> OPENAI_/DEEPSEEK_/GEMINI_/DASHSCOPE_
#   7) WHEN=fallback：启发式失败才调（省 token）
#   8) AUTOPILOT_VISION_REASONING_EFFORT 默认 none（可回退 AP_AI_REASONING_EFFORT）
#   9) AUTOPILOT_VISION_TEMPERATURE 默认 0.1（可回退 AP_AI_TEMPERATURE；gpt-5 等会省略）
#  10) AUTOPILOT_VISION_VERBOSITY=none|low|medium|high（仅 gpt-5；可回退 AP_AI_VERBOSITY）
#
AUTOPILOT_INTENT_VISION=0
# AUTOPILOT_VISION_ALLOW_LOCAL_KEY=1

# AUTOPILOT_VISION_WHEN=fallback
# 单用例 vision 调用硬顶（默认 30；0=不限，不建议）
# AUTOPILOT_VISION_MAX_CALLS_PER_CASE=30
# AUTOPILOT_VISION_IMAGE_MODE=auto
# AUTOPILOT_VISION_REASONING_EFFORT=none
# AUTOPILOT_VISION_TEMPERATURE=0.1
# AUTOPILOT_VISION_VERBOSITY=none
# AUTOPILOT_VISION_TIMEOUT_SEC=45
# AUTOPILOT_VISION_SCREENSHOT=1
# AUTOPILOT_VISION_DOM=1
# AUTOPILOT_VISION_DOM_MODE=compact
# AUTOPILOT_VISION_DOM_MAX=50
# AUTOPILOT_VISION_IMAGE_MAX_KB=220
# AUTOPILOT_VISION_IMAGE_SHORT_SIDE=560
# AUTOPILOT_VISION_IMAGE_DETAIL=low
# AUTOPILOT_VISION_IMAGE_ENHANCED=0
# AUTOPILOT_VISION_USAGE_DIR=
# Intent 默认拒绝 irreversible 关键字（uninstall / http_delete 等）；调试可放行：
# AUTOPILOT_INTENT_ALLOW_IRREVERSIBLE=1

# --- 方案 V-B：DeepSeek（Chat 用 v4-flash；Vision 默认回落 flash-vision-exp 识图）---
# AUTOPILOT_INTENT_VISION=1
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# AUTOPILOT_VISION_BASE_URL=https://api.deepseek.com
# AUTOPILOT_VISION_MODEL=deepseek-v4-flash-vision-exp
# AUTOPILOT_VISION_IMAGE_MODE=auto
# AUTOPILOT_VISION_DOM=1
# AUTOPILOT_VISION_REASONING_EFFORT=none
# AUTOPILOT_VISION_TEMPERATURE=0.1

# --- 方案 V-A：OpenAI 真多模态（截图 + DOM）---
# AUTOPILOT_INTENT_VISION=1
# AUTOPILOT_VISION_API_KEY=sk-...
# AUTOPILOT_VISION_BASE_URL=https://api.openai.com/v1
# AUTOPILOT_VISION_MODEL=gpt-5.4-mini
# AUTOPILOT_VISION_IMAGE_MODE=auto
# AUTOPILOT_VISION_REASONING_EFFORT=none
# AUTOPILOT_VISION_TEMPERATURE=0.1
# AUTOPILOT_VISION_VERBOSITY=low

# --- 方案 V-C：千问 VL ---
# AUTOPILOT_INTENT_VISION=1
# DASHSCOPE_API_KEY=
# AUTOPILOT_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AUTOPILOT_VISION_MODEL=qwen-vl-plus
# AUTOPILOT_VISION_IMAGE_MODE=auto
# AUTOPILOT_VISION_REASONING_EFFORT=none
# AUTOPILOT_VISION_TEMPERATURE=0.1

# --- 方案 V-D：Gemini ---
# AUTOPILOT_INTENT_VISION=1
# GEMINI_API_KEY=
# AUTOPILOT_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AUTOPILOT_VISION_MODEL=gemini-3.5-flash
# AUTOPILOT_VISION_IMAGE_MODE=auto
# AUTOPILOT_VISION_REASONING_EFFORT=none
# AUTOPILOT_VISION_TEMPERATURE=0.1

# ---------- 链路 3 AI 辅助编写（采页 → 传统关键字用例）----------
# 密钥边界：企业 Key 只在 Platform Ops；IDE 登录后走 POST /ops/ai/codegen。
# 部署锁定 AUTOPILOT_PLATFORM_URL / platform.url 时默认 platform（无需本机 Key）。
# 下列 AP_AI_* 仅为单机开发逃生口；禁止提交真实 Key；settings.json 也不存 Key。
# AUTOPILOT_AUTHORING_LLM_MODE=platform
# AUTOPILOT_AUTHORING_LLM_MODE=local
# AP_AI_API_KEY=
# AP_AI_BASE_URL=https://api.openai.com/v1
# AP_AI_MODEL=gpt-5.4-mini
# 可选分模型（未配则用 AP_AI_MODEL）：规划/编写 vs 深度定位
# AP_AI_PLANNING_MODEL=gpt-5.4-mini
# AP_AI_LOCATE_MODEL=gpt-5.4-mini
# 启发式定位失败后再打定位 LLM（默认关）
# AUTOPILOT_AUTHORING_DEEP_THINK=1
# 采页为空时可选 Vision 兜底（默认关；还需 AUTOPILOT_INTENT_VISION=1）
# AUTOPILOT_AUTHORING_VISION_FALLBACK=1
# 中文应用名匹配时最多探测多少个桌面应用的显示名（Android，默认 12；0=关闭探测）
# AUTOPILOT_AUTHORING_LABEL_PROBES=12
# Android 显示名磁盘缓存（默认 ~/.autopilot/android_app_labels.json；0=关闭）
# AUTOPILOT_AUTHORING_LABEL_CACHE=D:\cache\autopilot-android-labels.json
# 企业/项目自定义应用别名目录（JSON；优先于内置；第三方包仍须在设备安装列表中验证）
# AUTOPILOT_AUTHORING_APP_ALIASES_FILE=D:\config\autopilot-app-aliases.json
# 编写收尾事后裁判：off | heuristic（默认，不耗 token）| llm（未完成时再打一轮文本模型；不改步骤结果）
# AUTOPILOT_AUTHORING_GOAL_JUDGE=heuristic
# 失败用例事后二审：off | heuristic（默认，不耗 token）。只加注，不改 PASS/FAIL
# AUTOPILOT_FAIL_REVIEW=heuristic

# ---------- 接收 Platform APPROVED Webhook（高级可选，非链路 3）----------
# Platform\.env: MC_DESIGN_WEBHOOK_URL=http://127.0.0.1:8765/hooks/intent
# IDE: python -m autopilot.intent serve-webhook --project <工程目录>
AUTOPILOT_INTENT_WEBHOOK_HOST=127.0.0.1
AUTOPILOT_INTENT_WEBHOOK_PORT=8765
# AUTOPILOT_WEBHOOK_SECRET=
# MC_WEBHOOK_SECRET=

# ---------- 导入 / 轮询默认 ----------
# import / watch 建议加 --sync-status：把设计域 automation_status 回写为 INTENT_READY。
# 不加则 APPROVED 导入后状态可能仍停在 LOGICAL，Platform 侧不易看出「已进入 IDE」。
# 示例：
#   python -m autopilot.intent import --project <工程> --project-id <id> --sync-status
#   python -m autopilot.intent watch --project <工程> --project-id <id> --sync-status --once
#   python -m autopilot.intent vision-doctor
#   python -m autopilot.intent vision-doctor --ping
AUTOPILOT_INTENT_IMPORT_SUBDIR=imported_logical
AUTOPILOT_INTENT_WATCH_INTERVAL_SEC=30
AUTOPILOT_INTENT_MIN_QUALITY=0.8

# ---------- 真机命中率（可选，见 docs/intent-hitrate.md）----------
# AUTOPILOT_HITRATE_PROJECT=
# AUTOPILOT_HITRATE_DEVICE=
